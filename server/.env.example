# Server port
PORT=3000

# Client origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy global admin token (used by requireAdmin when AUTH_MODE !== 'jwt')
ADMIN_TOKEN=

# --- Multi-admin auth (added in multi-admin-auth change) ---

# Secret used to sign/verify JWTs (HS256). Use a long random value.
JWT_SECRET=

# Auth mode: 'legacy' (default, current global-token behavior) or 'jwt'
# (per-admin JWT auth + ownership checks). Do NOT flip to 'jwt' until
# the full multi-admin-auth change has been rolled out (PR2/PR3).
AUTH_MODE=legacy

# When truthy, enables POST /api/auth/register guarded by either a
# matching legacy ADMIN_TOKEN header or an authenticated admin (jwt).
# Keep disabled in production once all admins are bootstrapped.
AUTH_LEGACY_TOKEN_ENABLED=false

# Email of the bootstrap admin created by the 001_multi_admin_auth
# migration. Used only as documentation/reference for operators.
BOOTSTRAP_ADMIN_EMAIL=
